<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.7.2+ is part of Windows 10/11, so nothing extra has to be installed to run this -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>lfa-hw</AssemblyName>
    <RootNamespace>LfaHw</RootNamespace>
    <Version>0.2.3</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- compile against LibreHardwareMonitor but do not ship it: it is installed separately and loaded
         from its own folder at run time (see LhmLocator) -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" ExcludeAssets="runtime;native" />
  </ItemGroup>
</Project>
