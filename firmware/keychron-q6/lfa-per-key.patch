 }
@@ -208,6 +211,26 @@ static bool per_key_rgb_set_led_color(uint8_t *data) {
     return true;
 }
 
+// lights-fan-action: stage a slice of a frame; the frame is applied once its last LED arrives
+extern HSV           per_key_staged[RGB_MATRIX_LED_COUNT];
+extern volatile bool per_key_staged_ready;
+
+static bool lfa_frame_set(uint8_t *data) {
+    uint8_t start = data[0];
+    uint8_t count = data[1];
+
+    if (count > 9 || start + count > RGB_MATRIX_LED_COUNT) return false;
+
+    for (uint8_t i = 0; i < count; i++) {
+        per_key_staged[start + i].h = data[2 + i * 3];
+        per_key_staged[start + i].s = data[3 + i * 3];
+        per_key_staged[start + i].v = data[4 + i * 3];
+    }
+    if (start + count == RGB_MATRIX_LED_COUNT) per_key_staged_ready = true;
+
+    return true;
+}
+
 static bool mixed_rgb_get_effect_info(uint8_t *data) {
     data[1] = EFFECT_LAYERS;
     data[2] = EFFECTS_PER_LAYER;
@@ -393,6 +416,14 @@ void kc_rgb_matrix_rx(bool usb, uint8_t *data, uint8_t length) {
             success = mixed_rgb_set_effect_list(&data[2]);
             break;
 
+        case 0x20: // lights-fan-action: staged per-key frame
+            success = lfa_frame_set(&data[2]);
+            break;
+
+        case 0x21: // lights-fan-action: extension version
+            data[3] = 2;
+            break;
+
         default:
             data[0] = 0xFF;
             break;
